// workspaces, cpu, ram, editable volume, date, time, wifi and bluetooth menu
{
  "layer": "top",
  "position": "top",
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 10,

  "modules-left": [
    "clock",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio/slider#out",
    "custom/notification"
  ],
  "hyprland/window": {
    "format": "{initialClass}",
    "separate-outputs": true,
    "icon": true,
    "icon-size": 20,
    "rewrite": {
      "^$": "Desktop",
      "^(?:org|com|net|io)\\.[^\\.]+\\.([^\\.]+)$": "$1",
      "code-url-handler": "VS Code"
    }
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "persistent-workspaces": {
      "HDMI-A-1": [1, 2, 3, 4, 5]
    },
    "format": "{name}"
  },
  "cpu": {
    "interval": 1,
    "format": "CPU: {usage}%"
  },
  "memory": {
    "interval": 1,
    "format": "RAM: {percentage}%"
  },
  "pulseaudio/slider#out": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "zero-on-mute": false,
    "unmute-on-volume-change": false
  },
  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "max-length": 25
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
