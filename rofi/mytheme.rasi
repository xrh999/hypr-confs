* {
    font: "JetBrains Mono 12";

    /* Colour palette */
    primary-colour:   #263747;
    secondary-colour: #96C3CE;
    accent-colour:    #C69B62;
    border-colour:    #405568;
    light-border-colour: #58748C;
    highlight-colour: #51B1B8;
    workspace-colour: #304554;
    hover-colour:     #3A5160;

    /* Urgent states */
    urgent-foreground: #B5807B;
    urgent-background: #B57BA6;

    /* Active states */
    active-background: #405568;
    active-foreground: #C69B62;

    /* Selected states */
    selected-urgent-background: #B57BA6;
    selected-urgent-foreground: #263747;

    selected-active-background: #405568;
    selected-active-foreground: #51B1B8;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

/* Main layout */
window {
    background-color: @primary-colour;
    border-color: @border-colour;
    border-radius: 20px;

    padding: 16px;
    width: 450px;

    children: [mainbox];
}

mainbox {
    background-color: @primary-colour;
    spacing: 4px;

    children: [ inputbar, listview ];
}

/* Search bar */
inputbar {
    border: 2px;
    border-color: @light-border-colour;
    border-radius: 8px;
    background-color: @primary-colour;
    text-color: @secondary-colour;
    spacing: 8px;
}

prompt {
    text-color: @accent-colour;
    background-color: @primary-colour;
    padding: 4px;
}

entry {
    text-color: @secondary-colour;
    placeholder-color: #6F858F;
    placeholder: "Search here";
    background-color: @primary-colour;
    padding: 4px;
}

case-indicator {
    background-color: transparent;
    text-color: @secondary-colour;
}

/* Application list */
listview {
    background-color: @primary-colour;
    padding: 2px 0px 0px;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
    border: 0px;
    dynamic: true;
    lines: 10;
}

element {
    padding: 6px;
    cursor: pointer;
    border: 0px;
}

/* Normal entries */
element normal.normal {
    background-color: @primary-colour;
    text-color: @secondary-colour;
}

/* Urgent entries */
element normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

/* Active entries */
element normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

/* Selected entries */
element selected.normal {
    border-radius: 12px;
    background-color: @hover-colour;
    text-color: @accent-colour;
}

element selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

element selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}

/* Alternating entries */
element alternate.normal {
    background-color: @primary-colour;
    text-color: @secondary-colour;
}

element alternate.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

element alternate.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

/* Application icons and text */
element-text {
    background-color: transparent;
    cursor: inherit;
    highlight: inherit;
    text-color: inherit;
}

element-icon {
    background-color: transparent;
    size: 1em;
    cursor: inherit;
    text-color: inherit;
}

